<?xml version="1.0" encoding="UTF-8"?>
<persistence xmlns="https://jakarta.ee/xml/ns/persistence"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="https://jakarta.ee/xml/ns/persistence https://jakarta.ee/xml/ns/persistence/persistence_3_1.xsd"
             version="3.1">
    <persistence-unit name="tallerrepair-pu" transaction-type="RESOURCE_LOCAL">
        <provider>org.hibernate.jpa.HibernatePersistenceProvider</provider>

        <class>com.tallerrepair.tallerrepair.entity.BaseEntity</class>
        <class>com.tallerrepair.tallerrepair.entity.Permission</class>
        <class>com.tallerrepair.tallerrepair.entity.Role</class>
        <class>com.tallerrepair.tallerrepair.entity.User</class>
        <class>com.tallerrepair.tallerrepair.entity.SystemSetting</class>
        <class>com.tallerrepair.tallerrepair.entity.AuditLog</class>
        <class>com.tallerrepair.tallerrepair.entity.Customer</class>
        <class>com.tallerrepair.tallerrepair.entity.CustomerNote</class>
        <class>com.tallerrepair.tallerrepair.entity.Device</class>
        <class>com.tallerrepair.tallerrepair.entity.ServiceOrder</class>
        <class>com.tallerrepair.tallerrepair.entity.Budget</class>
        <class>com.tallerrepair.tallerrepair.entity.Quote</class>
        <class>com.tallerrepair.tallerrepair.entity.Supplier</class>
        <class>com.tallerrepair.tallerrepair.entity.Product</class>
        <class>com.tallerrepair.tallerrepair.entity.InventoryMovement</class>
        <class>com.tallerrepair.tallerrepair.entity.Sale</class>
        <class>com.tallerrepair.tallerrepair.entity.SaleItem</class>
        <class>com.tallerrepair.tallerrepair.entity.CashSession</class>
        <class>com.tallerrepair.tallerrepair.entity.CashMovement</class>
        <class>com.tallerrepair.tallerrepair.entity.Payment</class>
        <class>com.tallerrepair.tallerrepair.entity.ServiceOrderStatusHistory</class>
        <class>com.tallerrepair.tallerrepair.entity.TechnicalTest</class>

        <properties>
            <property name="jakarta.persistence.jdbc.driver" value="org.sqlite.JDBC"/>
            <property name="jakarta.persistence.jdbc.url" value="jdbc:sqlite:${user.home}/.tallerrepair/tallerrepair.db"/>
            <property name="jakarta.persistence.jdbc.user" value=""/>
            <property name="jakarta.persistence.jdbc.password" value=""/>

            <property name="hibernate.dialect" value="org.hibernate.community.dialect.SQLiteDialect"/>
            <property name="hibernate.hbm2ddl.auto" value="update"/>
            <property name="hibernate.show_sql" value="false"/>
            <property name="hibernate.format_sql" value="true"/>
            <property name="hibernate.connection.autocommit" value="false"/>
            <property name="hibernate.jdbc.time_zone" value="UTC"/>
        </properties>
    </persistence-unit>
</persistence>
