<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="500.0" prefWidth="760.0"
            xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.tallerrepair.tallerrepair.controller.LoginController">

    <children>
        <VBox alignment="CENTER" spacing="18.0" prefWidth="380.0"
              AnchorPane.leftAnchor="190.0" AnchorPane.rightAnchor="190.0" AnchorPane.topAnchor="60.0" AnchorPane.bottomAnchor="60.0"
              styleClass="login-panel">
            <padding>
                <Insets top="28.0" right="28.0" bottom="28.0" left="28.0"/>
            </padding>

            <Label text="TALLERREPAIR" styleClass="login-brand"/>
            <Label text="Acceso al sistema" styleClass="login-title"/>

            <TextField fx:id="usernameField" promptText="Usuario" styleClass="login-field"/>
            <PasswordField fx:id="passwordField" promptText="Contraseña" styleClass="login-field"/>

            <Label fx:id="errorLabel" text="Usuario o contraseña incorrectos." visible="false" managed="false" styleClass="login-error"/>

            <Button fx:id="loginButton" text="Ingresar" onAction="#handleLogin" styleClass="login-button"/>

            <Label text="Usuario demo: admin / contraseña: admin123" styleClass="login-hint"/>
        </VBox>
    </children>
</AnchorPane>
