<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="900.0" prefWidth="1400.0"
            xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.tallerrepair.tallerrepair.controller.MainController">

    <left>
        <VBox spacing="8.0" styleClass="sidebar">
            <padding>
                <Insets top="16.0" right="14.0" bottom="16.0" left="14.0"/>
            </padding>

            <HBox alignment="CENTER_LEFT" spacing="10.0" styleClass="brand-box">
                <Label text="TR" styleClass="brand-mark"/>
                <Label text="TALLERREPAIR" styleClass="brand-name"/>
            </HBox>

            <Button text="Dashboard" userData="dashboard" onAction="#onMenuClick" styleClass="nav-button, active"/>
            <Button text="Clientes" userData="clientes" onAction="#onMenuClick" styleClass="nav-button"/>
            <Button text="Equipos" userData="equipos" onAction="#onMenuClick" styleClass="nav-button"/>
            <Button text="Órdenes" userData="ordenes" onAction="#onMenuClick" styleClass="nav-button"/>
            <Button text="Inventario" userData="inventario" onAction="#onMenuClick" styleClass="nav-button"/>
            <Button text="Ventas" userData="ventas" onAction="#onMenuClick" styleClass="nav-button"/>
            <Button text="Presupuestos" userData="presupuestos" onAction="#onMenuClick" styleClass="nav-button"/>
            <Button text="Caja" userData="caja" onAction="#onMenuClick" styleClass="nav-button"/>
            <Button text="Reportes" userData="reportes" onAction="#onMenuClick" styleClass="nav-button"/>
            <Button text="Configuración" userData="configuracion" onAction="#onMenuClick" styleClass="nav-button"/>
        </VBox>
    </left>

    <center>
        <BorderPane>
            <top>
                <HBox alignment="CENTER_LEFT" spacing="12.0" styleClass="topbar">
                    <padding>
                        <Insets top="18.0" right="24.0" bottom="18.0" left="24.0"/>
                    </padding>

                    <VBox spacing="4.0">
                        <Label fx:id="pageTitle" text="Dashboard" styleClass="page-title"/>
                        <Label fx:id="pageSubtitle" text="Resumen general del taller" styleClass="page-subtitle"/>
                    </VBox>

                    <HBox HBox.hgrow="ALWAYS"/>
                    <Label fx:id="statusBadge" text="Sistema local" styleClass="status-badge"/>
                </HBox>
            </top>

            <center>
                <StackPane fx:id="contentPane" styleClass="content-area"/>
            </center>
        </BorderPane>
    </center>
</BorderPane>
